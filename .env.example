# Default tracker: no API key or database required.
LIVE_PROVIDER=adsblol
FALLBACK_LIVE_PROVIDER=none
LIVE_REFRESH_MS=5000
SELECTED_REFRESH_MS=2500
LOG_LEVEL=error

# Optional PostgreSQL. Keep TLS enabled for hosted services.
DATABASE_URL=

# Public map configuration. These are URLs, never credentials.
NEXT_PUBLIC_MAP_STYLE_URL=
MAP_ASSET_ORIGINS=https://tiles.openfreemap.org

# Airplanes.live must not be enabled for a commercial deployment.
NON_COMMERCIAL_USE=false
AIRPLANES_TERMS_ACCEPTED=false

# ADSBiq documentation and terms currently conflict. Obtain clarification.
ADSBIQ_API_KEY=
ADSBIQ_TIER=free
ADSBIQ_TERMS_ACCEPTED=false
ADSBIQ_ACCESS_CONFIRMED=false
ADSBIQ_GLOBAL_DISPLAY_AUTHORIZED=false
ADSBIQ_STREAM_ENABLED=false
GLOBAL_LIVE_MODE=false

# OpenSky operational access requires the appropriate agreement.
OPENSKY_LICENSE_CONFIRMED=false
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Optional supplier schedules. PostgreSQL is required for quota accounting.
SCHEDULE_PROVIDER=none
SCHEDULE_API_KEY=
SCHEDULE_TERMS_ACCEPTED=false
SCHEDULE_MONTHLY_BUDGET=0

# Optional sources remain disabled without authorized adapters.
AIRSPACE_PROVIDER=none
NOTAM_PROVIDER=none
WEATHER_OVERLAY=true

# Enable only behind a proxy that overwrites, rather than trusts, inbound X-Forwarded-For.
TRUST_PROXY=false

# Production start defaults; PORT may be supplied by a hosting platform.
PORT=3000
HOSTNAME=0.0.0.0